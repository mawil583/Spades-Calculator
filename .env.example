# Copy this file to .env and fill in your Firebase Realtime Database web config.
# Get it from: Firebase console -> Project settings -> Your apps -> Web app ->
# the `firebaseConfig` object. Paste the WHOLE object as the JSON value below.
#
# The config is PUBLIC by design (it ships in the client bundle); real security
# is enforced by the Realtime Database rules in firebase.rules.json.
#
# Example (replace with your own values):
# VITE_FIREBASE_CONFIG={"apiKey":"AIza...","authDomain":"myproj.firebaseapp.com","databaseURL":"https://myproj-default-rtdb.firebaseio.com","projectId":"myproj","storageBucket":"myproj.firebasestorage.app","messagingSenderId":"1234","appId":"1:1234:web:abc","measurementId":"G-XXX"}
VITE_FIREBASE_CONFIG=